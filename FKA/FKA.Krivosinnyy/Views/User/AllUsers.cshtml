@model List<FKA.Krivosinnyy.BLL.ViewModels.User.UserViewModel>

@{
    ViewData["Title"] = "AllUsers";
}
<h3 class="fw-bold card-title"> Зарегистрированные пользователи </h3>

@foreach(var user in Model)
{
    <div class="my-4 container">
        <div class="my-1"> @user.Foto</div>
        <div class="my-1">
            <span class ="fw-bold"> Логин: </span>
            <span> @user.Login</span>
        </div>
        <div class="my-1">
            <span class="fw-bold"> ФИО: </span> <span>@user.Last_Name @user.First_Name @user.Middle_Name</span>
            <span class="fw-bold"> День рождения: </span> <span>@user.Day @((FKA.Krivosinnyy.BLL.ViewModels.Months)user.Month) @user.Year</span>
        </div>
        <div class="my-1">
            <span class="fw-bold"> Email: </span>
            <span> @user.Email</span>
        </div>
        <div class="my-1">
            <a class="btn btn-edit" method="get" asp-action="Edit" asp-controller="User" asp-route-userId=@user.Id> Редактировать </a>
        </div>
        <div class="my-1">
            <a class="btn btn-save" method="get" asp-action="ConfirmAccount" asp-controller="User" asp-route-userId=@user.Id> Активировать аккаунт </a>
        </div>
        <div class="my-1">
            <a class="btn btn-secondary" method="get" asp-action="ForgotPassword" asp-controller="User" asp-route-userId=@user.Id> Сбросить пароль </a>
        </div>
    </div>
}
