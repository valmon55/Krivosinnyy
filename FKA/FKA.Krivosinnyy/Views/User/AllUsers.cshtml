@model List<FKA.Krivosinnyy.BLL.ViewModels.User.UserViewModel>

@{
    ViewData["Title"] = "AllUsers";
}
<h3>List of users</h3>

@foreach(var user in Model)
{
    <div>
        <div> @user.Foto</div>
        <span> @user.Login</span>
        <span> @user.Last_Name @user.First_Name @user.Middle_Name</span>
        <span> @user.Day @((FKA.Krivosinnyy.BLL.ViewModels.Months)user.Month) @user.Year</span>
        <span> @user.Email</span>
        <a method="get" asp-action="Edit" asp-controller="User" asp-route-userId=@user.Id>Редактировать</a>
        <div>
            <a method="get" asp-action="ConfirmAccount" asp-controller="User" asp-route-userId=@user.Id>Активировать аккаунт</a>
        </div>
    </div>    
}
