@model FKA.Krivosinnyy.BLL.ViewModels.User.UserViewModel

@{
    ViewData["Title"] = "EditUser";
}
<h3>Редактирование пользователя</h3>
<form method="post" asp-action="Edit" asp-controller="User">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="Id" value=@Model.Id hidden />
    <div>
        <label asp-for="First_Name"></label><br />
        <input asp-for="First_Name" />
        <span asp-validation-for="First_Name"></span>
    </div>
    <div>
        <label asp-for="Middle_Name"></label><br />
        <input asp-for="Middle_Name" />
        <span asp-validation-for="Middle_Name"></span>
    </div>
    <div>
        <label asp-for="Last_Name"></label><br />
        <input asp-for="Last_Name" />
        <span asp-validation-for="Last_Name"></span>
    </div>
    <div>
        <label asp-for="Email"></label><br />
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>День рождения</div>
    <div>
        <select asp-for="Day" id="day">
            <option value="">@Model.Day</option>
        </select>
        <span asp-validation-for="Day"></span>

        <select asp-for="Month" asp-items="Html.GetEnumSelectList<FKA.Krivosinnyy.BLL.ViewModels.Months>()"
                onchange="CorrectDay()" id="month">
            <option value="">@Model.Month</option>
        </select>
        <span asp-validation-for="Month"></span>

        <select asp-for="Year" id="year" onchange="CorrectDay()"
            asp-items="Enumerable.Range(DateTime.Now.AddYears(-100).Year, DateTime.Now.AddYears(-12).Year - DateTime.Now.AddYears(-100).Year).Reverse().Select(x=> new SelectListItem(x.ToString(), x.ToString()))">
            <option value="">@Model.Year</option>
        </select>
        <span asp-validation-for="Year"></span>
    </div>
    <div>
        <a method="get" asp-controller="User" asp-action="ChangePassword" asp-route-userId=@Model.Id>Изменить пароль</a>
    </div>
    <div class="mrgn">
        <label asp-for="Login"></label><br />
        <input asp-for="Login" />
        <span asp-validation-for="Login"></span>
    </div>
    <div>
        <input type="submit" value="Сохранить" />
    </div>
</form>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded",
        function () { FillData(@Model.Year, @Model.Month, @Model.Day) });

    function FillData(y, m, d) {
        FillDays();
        FillMonths();
        FillYears();
        SetCurrentDay(y, m, d);
    }
    function FillDays() {
        var day = document.getElementById("day");
        day.options.length = 0;
        for (var i = 1; i <= 31; i++) {
            AddOption(day, i, i);
        }
    }
    function FillMonths() {
        var month = document.getElementById("month");
        month.options.length = 0;
        AddOption(month, 1, "Январь");
        AddOption(month, 2, "Февраль");
        AddOption(month, 3, "Март");
        AddOption(month, 4, "Апрель");
        AddOption(month, 5, "Май");
        AddOption(month, 6, "Июнь");
        AddOption(month, 7, "Июль");
        AddOption(month, 8, "Август");
        AddOption(month, 9, "Сентябрь");
        AddOption(month, 10, "Октябрь");
        AddOption(month, 11, "Ноябрь");
        AddOption(month, 12, "Декабрь");
    }
    function FillYears() {
        var year = document.getElementById("year");
        year.options.length = 0;
        var currentDate = new Date();
        for (var i = 0; i < 100; i++) {
            AddOption(year, currentDate.getFullYear() - i, currentDate.getFullYear() - i)
        }
    }
    function SetCurrentDay(y, m, d) {
        var currentDate = new Date();
        var month = document.getElementById("month");
        var year = document.getElementById("year");
        var day = document.getElementById("day");

        year.value = y;
        month.value = m;
        CorrectDay();
        day.value = d;
    }
    function CorrectDay() {
        var month = document.getElementById("month");
        var year = document.getElementById("year");
        var day = document.getElementById("day");

        var selectedDay = day.value;

        if (month.value != 0 && year.value != 0) {
            var dayCount = 32 - new Date(year.value, month.value - 1, 32).getDate();
            day.options.length = 0;
            for (var i = 1; i <= dayCount; i++) {
                AddOption(day, i, i);
            }
        }
    }
    function AddOption(ddl, value, text) {
        var opt = document.createElement("option");
        opt.text = text;
        opt.value = value;
        ddl.add(opt);
    }
</script>

