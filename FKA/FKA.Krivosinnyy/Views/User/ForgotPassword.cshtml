@model FKA.Krivosinnyy.BLL.ViewModels.User.ForgotPasswordViewModel

@{
    ViewData["Title"] = "ChangePassword";
}
<h3 class="fw-bold card-title">Сбросить пароль</h3>
<form method="post" asp-action="ForgotPassword" asp-controller="User">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="my-1 mrgn">
        <label asp-for="Email"></label><br />
        <input asp-for="Email" class="text-danger" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div>
        <input class="btn btn-save" type="submit" value=" Изменить пароль " />
    </div>
</form>