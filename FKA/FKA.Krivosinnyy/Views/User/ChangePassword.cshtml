@model FKA.Krivosinnyy.BLL.ViewModels.User.ChangePasswordViewModel

@{
    ViewData["Title"] = "ChangePassword";
}
<h3>ChangePassword</h3>
<form method="post" asp-action="ChangePassword" asp-controller="User">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="Id" hidden />
    <div class="mrgn">
        <label asp-for="Password"></label><br />
        <input asp-for="Password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div class="mrgn">
        <label asp-for="NewPassword"></label><br />
        <input asp-for="NewPassword" />
        <span asp-validation-for="NewPassword"></span>
    </div>
    <div class="mrgn">
        <label asp-for="NewPasswordConfirm"></label><br />
        <input asp-for="NewPasswordConfirm" />
        <span asp-validation-for="NewPasswordConfirm"></span>
    </div>
    <div>
        <input type="submit" value="Изменить пароль" />
    </div>
</form>