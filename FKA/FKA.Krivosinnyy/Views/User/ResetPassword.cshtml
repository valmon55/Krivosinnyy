@model FKA.Krivosinnyy.BLL.ViewModels.User.ResetPasswordViewModel
@{
    ViewData["Title"] = "Сброс пароля";
}

<h2 class="fw-bold card-title">@ViewData["Title"]</h2>
<h4 class="fw-bold my-4">Введите пароль</h4>
<hr />
<div class="my-1 row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="my-1 form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="my-1 form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="my-1 form-group">
                <label asp-for="PasswordConfirm"></label>
                <input asp-for="PasswordConfirm" class="form-control" />
                <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
            </div>
            <div class="my-1 form-group">
                <label asp-for="Code"></label>
                <textarea asp-for="Code" class="form-control" placeholder="Код из письма"></textarea>
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="my-1">
                <button class="bnt btn-save" type="submit" class="btn btn-primary"> Сбросить </button>
            </div>
        </form>
    </div>
</div>
