@model FKA.Krivosinnyy.BLL.ViewModels.User.ResetPasswordViewModel
@{
    ViewData["Title"] = "Сброс пароля";
}

<h2>@ViewData["Title"]</h2>
<h4>Введите пароль</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PasswordConfirm"></label>
                <input asp-for="PasswordConfirm" class="form-control" />
                <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Code"></label>
                <textarea asp-for="Code" class="form-control" placeholder="Код из письма"></textarea>
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <button class="btn-save" type="submit" class="btn btn-primary"> Сбросить </button>
        </form>
    </div>
</div>
