@model FKA.Krivosinnyy.BLL.ViewModels.Person.PersonViewModel

@{
    ViewData["Title"] = "Person";
}
<h3>Person Page</h3>

<div>
    @* Клиент не помет получить доступ к файлам напрямую на сервере *@
    @* Необходимо создавать ссылку на ресурс изображения, который *@
    @* браузер запрашивает после получения html страницы *@
    <div>
        <img src = "@Url.Content(Model.Photo)" height="100px" width="100px" />
    </div>
    <form method="post" asp-action="SetAvatar" asp-controller="Person" asp-route-personId=@Model.Id enctype="multipart/form-data">
        <input type="file" name="uploadedFile" />
        <input type="submit" value="Загрузить фото" />
    </form>
    <input asp-for="Id" hidden />
    <span> @Model.LastName @Model.FirstName @Model.MiddleName</span>
    <span> @Model.Day @((FKA.Krivosinnyy.BLL.ViewModels.Months)Model.Month) @Model.Year</span>
    <a method="get" asp-action="Edit" asp-controller="Person" asp-route-personId=@Model.Id>Редактировать</a>
    <a method="get" asp-action="EditPersonRelations" asp-controller="Relationship" asp-route-personId=@Model.Id>Добавить в профиль близкого</a>
</div>

