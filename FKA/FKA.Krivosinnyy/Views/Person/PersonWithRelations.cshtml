@model FKA.Krivosinnyy.BLL.ViewModels.Relationship.EditPersonRelationsViewModel

@{
    ViewData["Title"] = "Person";
}
<h3 class="fw-bold card-title">Страница человека</h3>

<div class="person-block my-4 container">
    @* Клиент не помет получить доступ к файлам напрямую на сервере *@
    @* Необходимо создавать ссылку на ресурс изображения, который *@
    @* браузер запрашивает после получения html страницы *@
    <div class="my-1">
        <img src = "@Url.Content(Model.Person.Avatar.Path)" height="100px" width="100px" />
    </div>
    <form class="my-1" method="post" asp-action="SetAvatar" asp-controller="Person" asp-route-personId=@Model.Person.Id enctype="multipart/form-data">
        <input class="btn btn-save" type="file" name="uploadedFile" />
        <input class="btn btn-save" type="submit" value="Загрузить фото" />
    </form>
    <input asp-for="Person.Id" hidden />
    <span class="fw-bold"> @Model.Person.LastName @Model.Person.FirstName @Model.Person.MiddleName</span>
    <span class="fw-bold"> @Model.Person.BirthDate.Day @((FKA.Krivosinnyy.BLL.ViewModels.Months)Model.Person.BirthDate.Month) @Model.Person.BirthDate.Year</span>
    <a class="btn btn-edit" method="get" asp-action="EditPerson" asp-controller="Person" asp-route-personId=@Model.Person.Id>Редактировать</a>
    <div class="my-1 container">
        <h6 class="fw-bold card-title">Ваши друзья и близкие</h6>
        @foreach (var person in Model.RelatedPersons)
        {
            <div class="person-block my-1 container">
                <label>
                    @* <div>@person.Avatar.Path</div> *@
                    <img src="@Url.Content(person.Avatar.Path)" height="100px" width="100px" />
                    <span> @person.LastName @person.FirstName @person.MiddleName</span>
                    <span> @person.RelationType</span>
                    <a class="btn btn-edit" method="get" asp-action="EditPersonRelation" asp-controller="Relationship"
                       asp-route-personId=@Model.Person.Id asp-route-relatedPersonId=@person.Id> Редактировать </a>
                </label>
            </div>
        }
    </div>
    <div class="my-1">
        <a class="btn btn-save" method="get" asp-action="EditPersonRelations" asp-controller="Relationship" asp-route-personId=@Model.Person.Id>Добавить в профиль близкого</a>
    </div>
</div>

