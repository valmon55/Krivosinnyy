@model List<FKA.Krivosinnyy.BLL.ViewModels.Person.PersonViewModel>

@{
    ViewData["Title"] = "AllPersons";
}
<h3>List of persons</h3>
<div>
    <span>Add Person</span>
    <a class="btn-save" method="get" asp-action="AddPerson" asp-controller="Person">Добавить человека</a>
</div>
@foreach(var person in Model)
{
    <div class="person-block">
        @* <div> @person.Photo</div> *@
        <div>
            <img src="@Url.Content(person.Photo)" height="100px" width="100px" />
        </div>
        <span> @person.LastName @person.FirstName @person.MiddleName</span>
        <span> @person.Day @((FKA.Krivosinnyy.BLL.ViewModels.Months)person.Month) @person.Year</span>
        <a class="btn-save" method="get" asp-action="ViewPerson" asp-controller="Person" asp-route-personId=@person.Id>Открыть профиль</a>
        <form method="post" asp-action="RemovePerson" asp-controller="Person" asp-route-personId=@person.Id>
            <input class="btn-delete" type="submit" value="Удалить человека" />
        </form>
    </div>    
}
