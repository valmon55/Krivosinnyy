@model FKA.Krivosinnyy.BLL.ViewModels.Relationship.EditPersonRelationsViewModel
@using FKA.Krivosinnyy.DAL.Entities;

@{
    ViewData["Title"] = "EditPersonRelation";
}
<h3 class="fw-bold card-title">Изменение списка родственников</h3>
<div class="my-4">
    <img src="@Url.Content(Model.Person.Avatar.Path)" height="100px" width="100px" />
    <span class="fw-bold" > @Model.Person.LastName @Model.Person.FirstName @Model.Person.MiddleName</span>
</div>
<form method="post" asp-action="EditPersonRelations" asp-controller="Relationship" >
    <div asp-validation-summary=ModelOnly class="text-danger"></div>
    @* <input asp-for=Person value=@Model.Person hidden /> *@
    <input asp-for=PersonId value=@Model.Person.Id hidden />

    <input asp-for=Person.Id value=@Model.Person.Id hidden />
    <input asp-for=Person.FirstName value=@Model.Person.FirstName hidden />
    <input asp-for=Person.MiddleName value=@Model.Person.MiddleName hidden />
    <input asp-for=Person.LastName value=@Model.Person.LastName hidden />
    <input asp-for=Person.BirthDate value=@Model.Person.BirthDate hidden />
    <input asp-for=Person.Gender value=@Model.Person.Gender hidden />
    <input asp-for=Person.Avatar.Path value=@Model.Person.Avatar.Path hidden />
    
    @{
        var relatedPerson = new List<PersonWithRelTypeExt>();
        var personWithRelTypeExt = new PersonWithRelTypeExt() { Avatar = new FKA.Krivosinnyy.DAL.Entities.File() };
    }

    @foreach (var person in Model.RelatedPersons)
    {
            <div class="person-block my-4 container">
            @foreach(var checkPersonId in Model.CheckedRelatedPersonIds)
            {
                if (checkPersonId.Key == @person.Id)
                {
                    if(checkPersonId.Value)
                    {
                        <input class="mx-4" type="checkbox" name="SelectedPersons" checked="checked" value=@checkPersonId.Key />
                    }
                    else
                    {
                        <input class="mx-4" type="checkbox" name="SelectedPersons" value=@checkPersonId.Key />
                    }
                }
            }            
            <label>
                @* <div>@person.Avatar.Path</div> *@
                <img class="mx-4" src="@Url.Content(person.Avatar.Path)" height="100px" width="100px" />
                <span class="fw-bold mx-4" > @person.LastName @person.FirstName @person.MiddleName</span>

                <input asp-for=@personWithRelTypeExt.Id value=@person.Id hidden />
                <input asp-for=@personWithRelTypeExt.FirstName value=@person.FirstName type=hidden />
                <input asp-for=@personWithRelTypeExt.MiddleName value=@person.MiddleName type=hidden />
                <input asp-for=@personWithRelTypeExt.LastName value=@person.LastName type=hidden />
                <input asp-for=@personWithRelTypeExt.BirthDate value=@person.BirthDate type=hidden />
                <input asp-for=@personWithRelTypeExt.Gender value=@person.Gender type=hidden />
                <input asp-for=@personWithRelTypeExt.Avatar.Path value=@{ person.Avatar.Path ??= string.Empty;} type=hidden />
                <span class="mx-4">
                    <select asp-for=@personWithRelTypeExt.RelationType asp-items="Html.GetEnumSelectList<FKA.Krivosinnyy.DAL.Entities.Relation>()"></select>
                </span>
            </label>
            @{
                relatedPerson.Add(personWithRelTypeExt);
            }
        </div>    
    }
        <input asp-for=RelatedPersons value=@relatedPerson hidden />
    @* <input asp-for=@Model name="p" value=@Model hidden /> *@
    @* <input asp-for=CheckedRelatedPersonIds name=RelatedPersonsDic value=@Model.CheckedRelatedPersonIds hidden /> *@
    <div class="my-1">
        <input class="btn btn-edit" type="submit" value=" Изменить " />
    </div>
</form>